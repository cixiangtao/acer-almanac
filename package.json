{
  "name": "acer-almanac-workspace",
  "version": "1.0.2",
  "private": true,
  "description": "A deterministic Chinese almanac npm package, Web Component, Chrome extension, and preview",
  "license": "MIT",
  "author": "cixiangtao",
  "scripts": {
    "build": "vp run -r build",
    "build:core": "vp run acer-almanac#build",
    "build:extension": "vp run @acer-almanac/chrome-extension#build",
    "check": "vp check",
    "cws:publish": "node scripts/chrome-webstore.mjs publish",
    "cws:secrets": "node scripts/sync-chrome-webstore-secrets.mjs",
    "cws:status": "node scripts/chrome-webstore.mjs status",
    "dev": "vp run @acer-almanac/web#dev",
    "dev:extension": "vp run @acer-almanac/chrome-extension#dev",
    "lint:fix": "vp lint --fix",
    "package:extension": "node scripts/package-chrome-extension.mjs",
    "prepare": "vp config && vp run acer-almanac#build",
    "release:check": "pnpm run check && pnpm run test && pnpm run build:core && cd packages/core && npm pack --dry-run --json",
    "release:dry": "cd packages/core && release-it --dry-run",
    "release:prepare": "cd packages/core && release-it",
    "test": "vp test"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.6",
    "happy-dom": "^20.10.6",
    "release-it": "^20.2.1",
    "typescript": "^6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.6"
  },
  "engines": {
    "node": "^22.13.0 || >= 24.0.0"
  },
  "packageManager": "pnpm@10.34.4"
}
