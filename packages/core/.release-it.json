{
  "$schema": "https://unpkg.com/release-it@20/schema/release-it.json",
  "git": {
    "commitMessage": "chore(release): v${version}",
    "requireBranch": "release/npm-v*",
    "requireCleanWorkingDir": true,
    "tag": false,
    "push": false
  },
  "hooks": {
    "before:init": "pnpm --dir ../.. run release:check",
    "after:bump": "pnpm --dir ../.. install --lockfile-only && test \"$(git branch --show-current)\" = \"release/npm-v${version}\"",
    "after:release": "echo Prepared release PR commit for ${name} v${version}"
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  }
}
