# Chrome Web Store API 发布凭据。
# 复制为 .env.chrome-webstore 后填写；真实值禁止提交到 Git。

# OAuth 2.0 客户端 ID。
# 来源：Google Cloud Console → API 和服务 → 凭据 → OAuth 2.0 客户端 ID。
CWS_CLIENT_ID=

# OAuth 2.0 客户端密钥，与上面的客户端 ID 属于同一个 OAuth 客户端。
# 来源：Google Cloud Console 的 OAuth 客户端详情。敏感信息，请勿公开。
CWS_CLIENT_SECRET=

# OAuth 2.0 刷新令牌，脚本用它换取临时访问令牌。
# 来源：OAuth 2.0 Playground，授权范围为 chromewebstore；必须使用扩展发布者账号生成。
# 敏感信息，请勿公开；重新授权或撤销访问后可能需要重新生成。
CWS_REFRESH_TOKEN=

# Chrome Web Store 发布方 ID，用于构造 API 的 publishers/{publisherId} 路径。
# 来源：Chrome Web Store Developer Dashboard 的发布方/账号信息。
CWS_PUBLISHER_ID=

# Chrome 扩展条目 ID，通常是 32 位小写字母，可从商店条目或开发者后台 URL 找到。
# 它标识要上传和发布的扩展，不是 OAuth 密钥。
CWS_EXTENSION_ID=
